# DONZO / TOPUP HUB — backend environment
# Copy to .env and fill in real values. NEVER commit .env.

# ── Django core ──
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-change-this
# DEBUG defaults to False (secure). Set True ONLY for local development.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──
# Production: set DATABASE_URL to a PostgreSQL DSN (Neon/Render give you one):
#   postgresql://user:pass@host:5432/dbname
# DATABASE_URL=
# Or the discrete vars (falls back to a local SQLite file if DB_NAME is unset):
DB_ENGINE=django.db.backends.postgresql
DB_NAME=topup_hub
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# Running DEBUG=False on SQLite is refused unless you opt in on purpose:
# ALLOW_SQLITE_PROD=false

# ── WebSocket / Channels ──
# Without REDIS_URL the in-memory channel layer is used — fine for a single
# process only. Set this to a Redis URL as soon as daphne runs >1 worker or
# the bot needs to push to sockets.
# REDIS_URL=redis://localhost:6379/0

# ── CORS ──
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:8000

# ── HTTPS (only read when DEBUG=False) ──
SECURE_SSL_REDIRECT=true
# Number of reverse proxies in front of the app (1 behind a tunnel/nginx, 0
# when hitting Django directly). Wrong value = spoofable client IP in throttles.
NUM_PROXIES=1

# ── Secrets encryption (Fernet key for the Setting table) ──
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WEB_APP_URL=http://localhost:3002
# user_client (Telethon card monitor)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Fragment API (identity + Premium/Stars pricing) ──
FRAGMENT_API_BASE_URL=
FRAGMENT_WALLET_SEED=
FRAGMENT_COOKIES=

# ── Payment gateways (optional) ──
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
